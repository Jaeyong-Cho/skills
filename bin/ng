#!/bin/bash
# ng <slug> [description] — creates ~/wiki/goals/<slug>/, registers it under
# "## Active" in ~/wiki/goals.md, links it into ~/wiki/today/research/NN-<slug>
# so it's visible immediately, and appends a checklist entry to
# ~/wiki/today/journal.md.
# ng list — prints every goal with a 1-based index, grouped by Active/Done.
# ng rm <slug|index> — deletes a goal (by slug, or by the index `ng list`
# just showed): the directory, its goals.md line (Active or Done), and any
# today/research symlink pointing at it.
# This is the canonical goal command; any skill that starts a persistent,
# multi-day research effort should call `ng <slug>` rather than writing to
# ~/wiki/goals/ directly. daily-report re-links active goals each day and
# archives ones moved to "## Done" (see
# skills/daily-report/scripts/archive_today.sh).
set -euo pipefail

# Next zero-padded NN- sequence number unused among NN-* dirs in $1.
next_seq() {
  local dir="$1" max=-1 n d
  for d in "$dir"/[0-9][0-9]-*/; do
    [ -e "$d" ] || continue
    d="${d%/}"
    n="${d##*/}"; n="${n%%-*}"
    n=$((10#$n))
    (( n > max )) && max=$n
  done
  printf '%02d' $((max + 1))
}

create_goal() {
  local wiki="$1" slug="$2" desc="$3"

  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "FAIL: slug must be lowercase-kebab-case" >&2; return 1; }

  local goals_md="$wiki/goals.md"
  [ -f "$goals_md" ] || printf '# Goals\n\n## Active\n\n## Done\n' > "$goals_md"

  grep -q "^- $slug:" "$goals_md" && { echo "FAIL: goal '$slug' already registered" >&2; return 1; }

  mkdir -p "$wiki/goals/$slug"

  awk -v line="- $slug: $desc" '
    { print }
    /^## Active$/ { print line }
  ' "$goals_md" > "$goals_md.tmp"
  mv "$goals_md.tmp" "$goals_md"

  mkdir -p "$wiki/today/research"
  ln -s "$wiki/goals/$slug" "$wiki/today/research/$(next_seq "$wiki/today/research")-$slug"

  local journal="$wiki/today/journal.md"
  [ -f "$journal" ] || printf '# %s\n' "$(date +%Y-%m-%d)" > "$journal"
  printf -- '- %s: New goal: %s\n  - [ ] %s\n' "$(date +%H:%M:%S)" "$slug" "$desc" >> "$journal"
}

# Prints every goal line with a 1-based index shared across Active/Done,
# so `ng rm <index>` can target what was just listed.
list_goals() {
  local wiki="$1"
  local goals_md="$wiki/goals.md" i=0
  [ -f "$goals_md" ] || { echo "no goals yet"; return 0; }

  while IFS= read -r line; do
    case "$line" in
      "## "*) echo "$line"; continue ;;
    esac
    if [[ "$line" == "- "*": "* ]]; then
      i=$((i + 1))
      printf '  %d) %s\n' "$i" "${line#- }"
    fi
  done < "$goals_md"
}

# Resolves the slug at a 1-based index from `ng list`'s ordering.
# ponytail: index is recomputed from goals.md's current order each call, not
# a stored id — stale if goals.md changed since the last `ng list`.
slug_at_index() {
  local wiki="$1" idx="$2"
  local goals_md="$wiki/goals.md" i=0 line slug
  [ -f "$goals_md" ] || return 1

  while IFS= read -r line; do
    [[ "$line" == "- "*": "* ]] || continue
    i=$((i + 1))
    if [ "$i" -eq "$idx" ]; then
      slug="${line#- }"; slug="${slug%%:*}"
      echo "$slug"
      return 0
    fi
  done < "$goals_md"
  return 1
}

delete_goal() {
  local wiki="$1" slug="$2"

  [ -d "$wiki/goals/$slug" ] || { echo "FAIL: goal '$slug' not found" >&2; return 1; }

  local l
  for l in "$wiki/today/research"/*; do
    [ -L "$l" ] || continue
    [ "$(readlink "$l")" = "$wiki/goals/$slug" ] && rm "$l"
  done

  rm -rf "$wiki/goals/$slug"

  local goals_md="$wiki/goals.md"
  if [ -f "$goals_md" ]; then
    grep -v "^- $slug:" "$goals_md" > "$goals_md.tmp" || true
    mv "$goals_md.tmp" "$goals_md"
  fi
}

self_test() {
  local tmp
  tmp="$(mktemp -d)"

  create_goal "$tmp" "vendor-eval" "Evaluate vendor X vs Y"
  [ -d "$tmp/goals/vendor-eval" ] || { echo "FAIL: goal dir not created"; exit 1; }
  grep -q "^- vendor-eval: Evaluate vendor X vs Y$" "$tmp/goals.md" || { echo "FAIL: not registered in goals.md"; exit 1; }
  grep -A1 "^## Active$" "$tmp/goals.md" | grep -q "vendor-eval" || { echo "FAIL: not listed under Active"; exit 1; }
  grep -q "New goal: vendor-eval" "$tmp/today/journal.md" || { echo "FAIL: journal entry not written"; exit 1; }
  grep -q "^  - \[ \] Evaluate vendor X vs Y$" "$tmp/today/journal.md" || { echo "FAIL: checklist item not written"; exit 1; }
  [ -L "$tmp/today/research/00-vendor-eval" ] || { echo "FAIL: not linked into today/research"; exit 1; }

  if create_goal "$tmp" "vendor-eval" "dup" 2>/dev/null; then
    echo "FAIL: duplicate slug was allowed"; exit 1
  fi

  create_goal "$tmp" "other-goal" "Second thing"
  # New entries insert right after "## Active", so the most recent goal is index 1.
  list_goals "$tmp" | grep -q "1) other-goal: Second thing" || { echo "FAIL: list missing entry 1"; exit 1; }
  list_goals "$tmp" | grep -q "2) vendor-eval: Evaluate vendor X vs Y" || { echo "FAIL: list missing entry 2"; exit 1; }

  [ "$(slug_at_index "$tmp" 1)" = "other-goal" ] || { echo "FAIL: slug_at_index wrong lookup"; exit 1; }
  delete_goal "$tmp" "$(slug_at_index "$tmp" 1)"
  [ ! -d "$tmp/goals/other-goal" ] || { echo "FAIL: index-based delete didn't remove goal dir"; exit 1; }

  delete_goal "$tmp" "vendor-eval"
  [ ! -d "$tmp/goals/vendor-eval" ] || { echo "FAIL: goal dir not deleted"; exit 1; }
  [ ! -e "$tmp/today/research/00-vendor-eval" ] || { echo "FAIL: today/research symlink not cleaned up"; exit 1; }
  grep -q "vendor-eval" "$tmp/goals.md" && { echo "FAIL: goal still listed in goals.md"; exit 1; }

  if delete_goal "$tmp" "vendor-eval" 2>/dev/null; then
    echo "FAIL: deleting a missing goal was allowed"; exit 1
  fi

  rm -rf "$tmp"
  echo "self-test passed"
}

if [ "${1:-}" = "--test" ]; then
  self_test
  exit 0
fi

if [ "${1:-}" = "list" ]; then
  list_goals "$HOME/wiki"
  exit 0
fi

if [ "${1:-}" = "rm" ]; then
  arg="${2:-}"
  [ -n "$arg" ] || { echo "usage: ng rm <slug|index>" >&2; exit 1; }
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    slug="$(slug_at_index "$HOME/wiki" "$arg")" || { echo "FAIL: no goal at index $arg" >&2; exit 1; }
  else
    slug="$arg"
  fi
  delete_goal "$HOME/wiki" "$slug"
  echo "deleted ~/wiki/goals/$slug"
  exit 0
fi

slug="${1:-}"
[ -n "$slug" ] || { echo "usage: ng <slug> [description]  |  ng list  |  ng rm <slug|index>" >&2; exit 1; }
desc="${2:-}"

create_goal "$HOME/wiki" "$slug" "$desc"
echo "created ~/wiki/goals/$slug, linked into today/research/, and registered it as Active in ~/wiki/goals.md"
