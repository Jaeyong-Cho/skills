#!/usr/bin/env bash
agent=""
main="opus"
for arg in "$@"; do
  case "$arg" in
    -f) main="fable" ;;
    sonnet|opus|fable) main="$arg" ;;
    *) agent="$arg" ;;
  esac
done
if [ -z "$agent" ]; then
  PS3="agent? "
  select agent in claude copilot pi; do
    [ -n "$agent" ] && break
  done
fi
tmux-split 5 "$agent" "$main"
