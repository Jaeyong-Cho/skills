#!/usr/bin/env bash
# Usage: ts5 [claude|copilot|pi] [pattern]
#   pattern: 3 chars of o=opus s=sonnet h=haiku f=fable, one per left pane (top/middle/bottom)
#   e.g. ts5 claude osh (default), ts5 claude ooo
agent=""
pattern="osh"
for arg in "$@"; do
  case "$arg" in
    [oshf][oshf][oshf]) pattern="$arg" ;;
    *) agent="$arg" ;;
  esac
done
if [ -z "$agent" ]; then
  PS3="agent? "
  select agent in claude copilot pi; do
    [ -n "$agent" ] && break
  done
fi
tmux-split 5 "$agent" "$pattern"
