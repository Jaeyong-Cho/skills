#!/usr/bin/env bash
# Usage: tmux-split 3   → top 1, bottom 2
#        tmux-split 4   → top 2, bottom 2

ORIGIN=$(tmux display-message -p '#P')

case "${1:-}" in
  3)
    tmux split-window -v          # top / bottom; focus → bottom
    tmux split-window -h          # bottom-left / bottom-right
    tmux select-pane -t "$ORIGIN"
    ;;
  4)
    tmux split-window -v          # top / bottom; focus → bottom
    tmux split-window -h          # bottom-left / bottom-right; focus → bottom-right
    tmux select-pane -t "$ORIGIN" # back to top-left
    tmux split-window -h          # top-left / top-right
    tmux select-pane -t "$ORIGIN"
    ;;
  *)
    echo "Usage: tmux-split 3|4"
    echo "  3 → top 1, bottom 2"
    echo "  4 → top 2, bottom 2"
    exit 1
    ;;
esac
