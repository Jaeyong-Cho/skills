#!/usr/bin/env bash
# Usage: tmux-split ts2  → left / right
#        tmux-split 3   → left top+bottom, right 1
#        tmux-split 4   → top 2, bottom 2
#        tmux-split 5   → left 20% (3 stacked) / right 80% (2 stacked)

ORIGIN=$(tmux display-message -p '#P')

case "${1:-}" in
  ts2)
    tmux split-window -h          # left / right
    tmux select-pane -t "$ORIGIN"
    ;;
  3)
    tmux split-window -h          # left / right; focus → right
    tmux select-pane -t "$ORIGIN" # back to left
    tmux split-window -v          # left-top / left-bottom
    tmux select-pane -t "$ORIGIN"
    ;;
  4)
    tmux split-window -v          # top / bottom; focus → bottom
    tmux split-window -h          # bottom-left / bottom-right; focus → bottom-right
    tmux select-pane -t "$ORIGIN" # back to top-left
    tmux split-window -h          # top-left / top-right
    tmux select-pane -t "$ORIGIN"
    ;;
  5)
    tmux split-window -h -p 80    # left(20%) / right(80%); focus → right
    tmux split-window -v          # right-top / right-bottom; focus → bottom
    tmux select-pane -t "$ORIGIN" # back to left
    tmux split-window -v -p 67    # left-top(1/3) / left-rest(2/3); focus → bottom
    tmux split-window -v          # left-rest → left-middle / left-bottom
    tmux select-pane -t "$ORIGIN" # back to left-top
    ;;
  *)
    echo "Usage: tmux-split ts2|3|4|5"
    echo "  ts2 → left / right"
    echo "  3   → left top+bottom, right 1"
    echo "  4   → top 2, bottom 2"
    echo "  5   → left 20% (3 stacked) / right 80% (2 stacked)"
    exit 1
    ;;
esac
