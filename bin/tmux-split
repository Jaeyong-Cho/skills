#!/usr/bin/env bash
# Usage: tmux-split ts2  → left / right
#        tmux-split 3   → left top+bottom, right 1
#        tmux-split 4   → top 2, bottom 2
#        tmux-split 5   → left 30% (3 stacked) / right 70% (2 stacked); right panes stay plain terminals
#        tmux-split 5 claude|copilot|pi → same, plus launch sonnet (middle) + haiku (bottom) in the left panes
#        tmux-split 5 claude|copilot|pi [sonnet|opus|fable] → also picks the top-pane "main" model (default opus)

ORIGIN=$(tmux display-message -p '#{pane_id}')

case "${1:-}" in
  ts2)
    tmux split-window -h          # left / right
    tmux select-pane -t "$ORIGIN"
    ;;
  3)
    tmux split-window -h          # left / right; focus → right
    tmux select-pane -t "$ORIGIN" # back to left
    tmux split-window -v          # left-top / left-bottom
    tmux select-pane -t "$ORIGIN"
    ;;
  4)
    tmux split-window -v          # top / bottom; focus → bottom
    tmux split-window -h          # bottom-left / bottom-right; focus → bottom-right
    tmux select-pane -t "$ORIGIN" # back to top-left
    tmux split-window -h          # top-left / top-right
    tmux select-pane -t "$ORIGIN"
    ;;
  5)
    AGENT="${2:-}"
    MAIN="${3:-opus}"
    LEFT_TOP="$ORIGIN"

    RIGHT_TOP=$(tmux split-window -h -l 70% -P -F '#{pane_id}')   # left(30%) / right(70%)
    tmux split-window -v -t "$RIGHT_TOP" >/dev/null               # right-top / right-bottom

    LEFT_MIDDLE=$(tmux split-window -v -l 67% -t "$LEFT_TOP" -P -F '#{pane_id}')  # left-top(1/3) / left-rest(2/3)
    LEFT_BOTTOM=$(tmux split-window -v -t "$LEFT_MIDDLE" -P -F '#{pane_id}')     # left-rest → left-middle / left-bottom

    tmux select-pane -t "$LEFT_TOP"

    case "$AGENT" in
      claude)
        case "$MAIN" in
          sonnet) TOP_CMD=ccs ;;
          fable)  TOP_CMD=ccf ;;
          *)      TOP_CMD=cco ;;
        esac
        tmux send-keys -t "$LEFT_TOP" "$TOP_CMD" Enter
        tmux send-keys -t "$LEFT_MIDDLE" 'ccs' Enter
        tmux send-keys -t "$LEFT_BOTTOM" 'cch' Enter
        ;;
      copilot)
        case "$MAIN" in
          sonnet) TOP_CMD=cgs ;;
          fable)  TOP_CMD=cgf ;;
          *)      TOP_CMD=cgo ;;
        esac
        tmux send-keys -t "$LEFT_TOP" "$TOP_CMD" Enter
        tmux send-keys -t "$LEFT_MIDDLE" 'cgs' Enter
        tmux send-keys -t "$LEFT_BOTTOM" 'cgh' Enter
        ;;
      pi)
        case "$MAIN" in
          sonnet) TOP_CMD=cps ;;
          fable)  TOP_CMD=cpf ;;
          *)      TOP_CMD=cpo ;;
        esac
        tmux send-keys -t "$LEFT_TOP" "$TOP_CMD" Enter
        tmux send-keys -t "$LEFT_MIDDLE" 'cps' Enter
        tmux send-keys -t "$LEFT_BOTTOM" 'cph' Enter
        ;;
      "") ;;
      *)
        echo "Unknown agent '$AGENT' (use claude|copilot|pi)" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Usage: tmux-split ts2|3|4|5 [claude|copilot|pi]"
    echo "  ts2 → left / right"
    echo "  3   → left top+bottom, right 1"
    echo "  4   → top 2, bottom 2"
    echo "  5   → left 30% (3 stacked) / right 70% (2 stacked)"
    echo "  5 claude|copilot|pi → also launches opus/sonnet/haiku in the left panes"
    exit 1
    ;;
esac
