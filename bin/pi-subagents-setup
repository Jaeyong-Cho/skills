#!/usr/bin/env bash
# Usage: pi-subagents-setup
#
# pi-subagents (https://github.com/nicobailon/pi-subagents) backs this
# project's intent-to-cycle problem-solving skills
# (define-problem/find-solutions/evaluate-solution) — a different, more
# capable package than pi-interactive-subagents (see
# bin/pi-interactive-subagents-setup / references/pi-custom-subagent.md).
#
# Installs the package (plus pi-web-access, which the builtin `researcher`
# agent needs for its web_search/fetch_content tools), writes this
# project's fact-finder/experimenter agents into .pi/agents/, and disables
# five of the package's six builtins (scout/worker/reviewer/oracle/
# delegate) via subagents.agentOverrides in .pi/settings.json — `researcher`
# stays enabled, @skills/find-solutions dispatches it for web reference
# examples (open-source architectures/frameworks that solve a comparable
# gap). See references/pi-subagents.md.
#
# Idempotent: skips any agent file that already exists, and only touches
# .pi/settings.json's overrides that aren't already set to disabled:true.
set -euo pipefail

cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if command -v pi &>/dev/null; then
  for pkg in npm:pi-subagents npm:pi-web-access; do
    if pi install "$pkg" &>/dev/null; then
      echo "  ✓ $pkg"
    else
      echo "  $pkg install failed, run manually: pi install $pkg"
    fi
  done
else
  echo "  pi CLI not found, skipping pi-subagents install"
fi

mkdir -p .pi/agents

write_agent() {
  local name="$1" file=".pi/agents/$1.md"
  if [ -e "$file" ]; then
    echo "  skip $file (already exists)"
    return
  fi
  cat > "$file"
  echo "  ✓ $file"
}

write_agent fact-finder <<'EOF'
---
name: fact-finder
description: Read-only investigation child for this project's problem-solving workflow — inspects the codebase/environment/docs and reports findings with file:line or command-output evidence. Never edits, never runs @skills/experiment.
tools: read, grep, find, ls, bash
allowNestedSubagents: false
---

You are a read-only fact-finding subagent for this project's intent-to-cycle
problem-solving workflow (@skills/define-problem, @skills/find-solutions,
@skills/evaluate-solution). Answer the exact question in your task with real
evidence only: a file:line, or the output of a read-only command you
actually ran (grep/read/ls/a query flag — never one that writes).

- Never edit, write, or run a command that mutates state. If the task truly
  needs something run to get evidence, say so instead of guessing — the
  caller should dispatch the `experimenter` agent for that, not you.
- Every claim carries its evidence inline. "Should"/"probably"/"likely" is
  not a finding — say "not found" or "uncertain, needs an experiment"
  instead of guessing.
- Keep the report short: the answer, then its evidence, nothing else.
EOF

write_agent experimenter <<'EOF'
---
name: experimenter
description: Runs @skills/experiment for real for this project's problem-solving workflow — plans the cheapest method, executes it, reports a verdict (supported/refuted/inconclusive) with the report file path. Used when fact-finder can't settle a claim by reading alone.
tools: read, grep, find, ls, bash, edit, write
skills: experiment
allowNestedSubagents: false
---

You are the experiment-running subagent for this project's intent-to-cycle
problem-solving workflow (@skills/define-problem, @skills/find-solutions,
@skills/evaluate-solution). Your task names one claim that can't be settled
by reading alone. Run `@skills/experiment` on it end to end: plan the
cheapest method, confirm it per that skill's own MUST-CONFIRM step, execute
it for real, and report its verdict plus the report file path — never a
simulated or imagined result.
EOF

python3 - ".pi/settings.json" <<'PY'
import json, sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text()) if path.exists() else {}
overrides = data.setdefault("subagents", {}).setdefault("agentOverrides", {})

changed = []
for name in ("scout", "worker", "reviewer", "oracle", "delegate"):
    entry = overrides.setdefault(name, {})
    if entry.get("disabled") is not True:
        entry["disabled"] = True
        changed.append(name)

if changed:
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"  ✓ {path} (disabled builtins: {', '.join(changed)}; researcher stays enabled)")
else:
    print(f"  skip {path} (builtin overrides already set)")
PY

echo "pi-subagents configured: fact-finder/experimenter agents, five builtins disabled, researcher kept for web reference search"
