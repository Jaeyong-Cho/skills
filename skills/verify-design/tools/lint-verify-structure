#!/usr/bin/env python3
"""Check a project's verify/ directory convention."""

from __future__ import annotations

import re
import sys
from pathlib import Path

REQUIRED_DOMAINS = ("prepare", "ut", "it", "e2e", "style", "archi")
LINK = re.compile(r"\[[^\]]+\]\(([^)]+)\)")


def local_links(index: Path) -> list[tuple[str, str]]:
    links = []
    for line in index.read_text(encoding="utf-8").splitlines():
        for raw in LINK.findall(line):
            target = raw.split("#", 1)[0].strip()
            if target and not target.startswith(("/", "http:", "https:", "mailto:")):
                links.append((target, line.strip()))
    return links


def lint(project: Path) -> tuple[list[str], list[str]]:
    root = project / "verify"
    errors: list[str] = []
    warnings: list[str] = []

    if not root.is_dir():
        return ["V-DIR-002: missing verify/ directory"], warnings

    for domain in REQUIRED_DOMAINS:
        directory = root / domain
        if not directory.is_dir():
            errors.append(f"V-DIR-002: missing verify/{domain}/")
        else:
            runner = directory / "run.sh"
            if not runner.is_file():
                errors.append(f"V-RUN-002: missing verify/{domain}/run.sh")
            elif not runner.stat().st_mode & 0o111:
                errors.append(f"V-RUN-002: verify/{domain}/run.sh is not executable")

    root_runner = root / "run.sh"
    if not root_runner.is_file():
        errors.append("V-RUN-001: missing verify/run.sh")
    elif not root_runner.stat().st_mode & 0o111:
        errors.append("V-RUN-001: verify/run.sh is not executable")

    directories = [root, *sorted(path for path in root.rglob("*") if path.is_dir())]
    for directory in directories:
        index = directory / "index.md"
        relative = directory.relative_to(project)
        if not index.is_file():
            errors.append(f"V-DIR-001: {relative}/ is missing index.md")
            continue

        links = local_links(index)
        linked_paths = set()
        for raw, line in links:
            target = (index.parent / raw).resolve()
            try:
                target.relative_to(project.resolve())
            except ValueError:
                errors.append(f"V-IDX-002: {relative}/ references outside project: {raw}")
                continue
            if not target.exists():
                errors.append(f"V-IDX-002: {relative}/ references missing path: {raw}")
                continue
            linked_paths.add(target)
            direct = target.parent == directory.resolve()
            if not direct:
                errors.append(f"V-IDX-004: {relative}/ references non-direct child: {raw}")
            if "—" not in line and " - " not in line:
                errors.append(f"V-IDX-003: {relative}/ entry lacks a short description: {line}")

        for child in sorted(directory.iterdir()):
            if child.name == "index.md":
                continue
            if child not in linked_paths:
                errors.append(
                    f"V-IDX-001: {relative}/ does not reference direct child {child.name}"
                    if child.is_dir()
                    else f"V-IDX-001: {relative}/ does not reference direct child file {child.name}"
                )

        depth = len(directory.relative_to(root).parts)
        if depth > 3:
            warnings.append(f"V-DEPTH-001: {relative}/ is deeper than <category>/<sub-category>")

    return errors, warnings


def main(argv: list[str]) -> int:
    project = Path(argv[1] if len(argv) > 1 else ".").resolve()
    errors, warnings = lint(project)
    for warning in warnings:
        print(f"WARNING {warning}")
    if errors:
        for error in errors:
            print(f"ERROR {error}")
        print(f"Verification structure: FAIL ({len(errors)} error(s))")
        return 1
    print("Verification structure: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
